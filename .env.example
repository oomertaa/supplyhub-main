# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Cheie service-role. NU o prefixa cu NEXT_PUBLIC_. Se foloseste doar server-side.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend — domeniul din FROM_EMAIL trebuie verificat in Resend, altfel trimiterea esueaza
RESEND_API_KEY=re_...
ADMIN_EMAIL=contact@supplyhub.ro
FROM_EMAIL=SupplyHub <notificari@supplyhub.ro>

NEXT_PUBLIC_SITE_URL=https://supplyhub.ro
